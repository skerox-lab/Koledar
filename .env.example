# Okoljske spremenljivke (vse so neobvezne)
PORT=8080
MSD_DATA=./data            # mapa z bazo (msd.db), datotekami (files/) in kopijami (backup/)
MSD_DEV=0                  # 1 = razvojni način (katerokoli geslo, menjava vloge v glavi) – samo za preizkušanje
MSD_SECURE_COOKIE=0        # 1, ko aplikacija teče za HTTPS
MSD_SESSION_DAYS=14        # koliko dni velja prijava
MSD_MAX_UPLOAD_MB=200      # največja naložena datoteka
MSD_BACKUP_HOUR=2
MSD_BACKUP_DAYS=30
TZ=Europe/Ljubljana
